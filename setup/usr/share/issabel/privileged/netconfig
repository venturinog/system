// Ejecuta la configuración general (hostname, DNS, gateway).
function action_generalConfiguration($opt)
{
    $sHostname = $sGateway = $sDNS1 = $sDNS2 = $sDNS6 = NULL;
    $timeout = 180;
    foreach ($opt[0] as $option) switch ($option[0]) {
    case '--host':      $sHostname = $option[1]; break;
    case '--gateway':   $sGateway  = $option[1]; break;
    case '--dns1':      $sDNS1     = $option[1]; break;
    case '--dns2':      $sDNS2     = $option[1]; break;
    case '--dns6':      $sDNS6     = $option[1]; break;
    case '--timeout':   $timeout   = intval($option[1]); break;
    }

    if (is_null($sDNS1) && !is_null($sDNS2)) {
        fwrite(STDERR, "ERR: DNS 2 requires DNS 1 to be set\n");
        return FALSE;
    }
    if (!is_null($sGateway) || !is_null($sDNS1)) {
        // Cambiar gateway/DNS puede cortar la administración remota.
        $timeout = ($timeout == 180) ? DEFAULT_TIMEOUT : $timeout;
    }

    $summary = 'genconf';
    if (!is_null($sHostname)) $summary .= ' host='.$sHostname;
    if (!is_null($sGateway))  $summary .= ' gateway='.$sGateway;
    if (!is_null($sDNS1))     $summary .= ' dns='.$sDNS1.(is_null($sDNS2)?'':' '.$sDNS2);
    if (!is_null($sDNS6))     $summary .= ' dns6='.$sDNS6;

    return applySafely($summary, $timeout, function() use ($sHostname, $sGateway, $sDNS1, $sDNS2, $sDNS6) {
        $primary = primaryConnection();

        if (!is_null($sGateway)) {
            if (is_null($primary)) {
                fwrite(STDERR, "ERR: no NetworkManager connection to set the gateway on\n");
                return FALSE;
            }
            if (!nmcliMod($primary, array('ipv4.gateway' => $sGateway))) return FALSE;
            foreach (activeConnectionNames() as $c) {
                if ($c !== $primary) nmcliMod($c, array('ipv4.never-default' => 'yes'));
            }
            if (!nmcliUp($primary)) return FALSE;
        }

        if (!is_null($sDNS1)) {
            if (is_null($primary)) {
                fwrite(STDERR, "ERR: no NetworkManager connection to set DNS on\n");
                return FALSE;
            }
            $dns = is_null($sDNS2) ? $sDNS1 : $sDNS1.' '.$sDNS2;
            if (!nmcliMod($primary, array('ipv4.dns' => $dns, 'ipv4.ignore-auto-dns' => 'yes')))
                return FALSE;
            if (!nmcliUp($primary)) return FALSE;
        }

        if (!is_null($sHostname)) setHostname($sHostname);

        if (!is_null($sDNS6)) {
            if (is_null($primary)) {
                fwrite(STDERR, "ERR: no NetworkManager connection to set IPv6 DNS on\n");
                return FALSE;
            }
            if (!nmcliMod($primary, array('ipv6.dns' => $sDNS6, 'ipv6.ignore-auto-dns' => 'yes')))
                return FALSE;
            if (!nmcliUp($primary)) return FALSE;
        }

        return TRUE;
    });
}

// Configura una interfaz concreta (static o dhcp).
function action_interfaceConfiguration($opt)
{
    $sDevice = $sBootproto = $sIpAddr = $sNetMask = NULL;
    $sIp6Method = $sIp6Addr = $sIp6Gw = NULL;
    $timeout = DEFAULT_TIMEOUT;
    foreach ($opt[0] as $option) switch ($option[0]) {
    case '--device':    $sDevice    = $option[1]; break;
    case '--bootproto': $sBootproto = $option[1]; break;
    case '--ipaddr':    $sIpAddr    = $option[1]; break;
    case '--netmask':   $sNetMask   = $option[1]; break;
    case '--ip6method': $sIp6Method = $option[1]; break;
    case '--ip6addr':   $sIp6Addr   = $option[1]; break;
    case '--ip6gw':     $sIp6Gw     = $option[1]; break;
    case '--timeout':   $timeout    = intval($option[1]); break;
    }

    if (is_null($sDevice)) {
        fwrite(STDERR, "ERR: network device must be specified\n");
        return FALSE;
    }
    if (is_null($sBootproto)) {
        fwrite(STDERR, "ERR: bootproto must be either dhcp or static\n");
        return FALSE;
    }
    if ($sBootproto == 'static') {
        if (is_null($sIpAddr)) {
            fwrite(STDERR, "ERR: --bootproto static requires --ipaddr\n");
            return FALSE;
        }
        if (is_null($sNetMask)) {
            fwrite(STDERR, "ERR: --bootproto static requires --netmask\n");
            return FALSE;
        }
    }

    $conn = connectionForDevice($sDevice);
    // Si no existe la conexión, createConnectionForDevice() la crea dentro del
    // apply seguro (así la reversión la elimina si el cambio no se confirma).

    if ($sBootproto == 'dhcp') {
        $props = array(
            'ipv4.method'    => 'auto',
            'ipv4.addresses' => '',
            'ipv4.gateway'   => '',
        );
    } else {
        $prefix = netmaskToPrefix($sNetMask);
        $props = array(
            'ipv4.method'    => 'manual',
            'ipv4.addresses' => $sIpAddr.'/'.$prefix,
        );
    }

    // IPv6 (opcional): método auto/dhcp/disabled o dirección estática + gateway.
    if (!is_null($sIp6Method) || !is_null($sIp6Addr) || !is_null($sIp6Gw)) {
        if (is_null($sIp6Method)) $sIp6Method = is_null($sIp6Addr) ? 'auto' : 'manual';
        $props['ipv6.method'] = $sIp6Method;
        if ($sIp6Method === 'manual') {
            if (is_null($sIp6Addr)) {
                fwrite(STDERR, "ERR: IPv6 method manual requires --ip6addr\n");
                return FALSE;
            }
            $props['ipv6.addresses'] = $sIp6Addr;
        } else {
            // Limpia direcciones estáticas previas al pasar a auto/dhcp/disabled.
            $props['ipv6.addresses'] = '';
            if ($sIp6Method === 'disabled') $props['ipv6.gateway'] = '';
        }
        if (!is_null($sIp6Gw)) $props['ipv6.gateway'] = $sIp6Gw;
    }

    $summary = 'ifconf device='.$sDevice.' bootproto='.$sBootproto
        .($sBootproto == 'static' ? ' addr='.$sIpAddr.'/'.netmaskToPrefix($sNetMask) : '')
        .($sIp6Method !== NULL ? ' ipv6='.$sIp6Method.(is_null($sIp6Addr) ? '' : ' '.$sIp6Addr) : '');

    return applySafely($summary, $timeout, function() use ($sDevice, $conn, $props) {
        $connection = $conn;
        if (is_null($connection)) {
            $connection = createConnectionForDevice($sDevice);
            if (is_null($connection)) return FALSE;
        }
        if (!nmcliMod($connection, $props)) return FALSE;
        return nmcliUp($connection);
    });
}

// Cancela la reversión de un cambio pendiente.
function action_confirm($token)
{
    if (!acquireLock()) { fwrite(STDERR, "ERR: unable to acquire state lock\n"); return FALSE; }
    $pending = readPending();
    if ($pending === NULL || !isset($pending['token']) || $pending['token'] !== $token) {
        fwrite(STDERR, "ERR: no such pending change\n");
        releaseLock();
        return FALSE;
    }
    cancelRollback($token);
    cleanupState($token);
    releaseLock();
    echo "confirmed $token\n";
    return TRUE;
}

// Aplica el snapshot de un cambio (invocado por el timer, o a mano).
function action_rollback($token)
{
    if (!acquireLock()) { fwrite(STDERR, "ERR: unable to acquire state lock\n"); return FALSE; }
    if (!is_dir(stateDir($token))) {
        fwrite(STDERR, "ERR: no snapshot for token $token\n");
        releaseLock();
        return FALSE;
    }
    $ok = restoreProfiles($token);
    cleanupState($token);
    releaseLock();
    echo "rolled back $token\n";
    return $ok;
}

// Imprime el cambio pendiente (JSON) para que la GUI pueda avisar.
function action_pending()
{
    $pending = readPending();
    if ($pending === NULL) {
        echo json_encode(array('pending' => FALSE))."\n";
        return TRUE;
    }
    $pending['pending'] = TRUE;
    $pending['remaining'] = max(0, intval($pending['expires']) - time());
    echo json_encode($pending)."\n";
    return TRUE;
}

// Revierte un cambio pendiente al arrancar (lo invoca issabel-netconfig-recover).
function action_recover()
{
    $pending = readPending();
    if ($pending === NULL || !isset($pending['token'])) return TRUE; // nada que hacer
    $token = $pending['token'];
    cancelRollback($token);
    return action_rollback($token);
}

// Imprime las rutas estáticas IPv4 por interfaz (JSON) para la grilla de la GUI.
function action_getroutes()
{
    $result = array();
    foreach (listConnectionNames() as $name) {
        $dev = nmcliLines(array('-g', 'connection.interface-name', 'con', 'show', $name));
        $dev = (count($dev) > 0) ? trim($dev[0]) : '';
        if ($dev === '') continue;
        $type = nmcliLines(array('-g', 'connection.type', 'con', 'show', $name));
        $type = (count($type) > 0) ? trim($type[0]) : '';
        if (!in_array($type, array('802-3-ethernet', 'vlan'))) continue;

        $specs = array();
        foreach (nmcliLines(array('-g', 'ipv4.routes', 'con', 'show', $name)) as $line) {
            foreach (explode(',', $line) as $s) {
                $s = trim($s);
                if ($s !== '') $specs[] = $s;
            }
        }
        $result[$dev] = $specs;
    }
    echo json_encode($result)."\n";
    return TRUE;
}

// Fija la lista completa de rutas estáticas IPv4 de una interfaz (apply seguro).
function action_setroutes($opt)
{
    $sDevice = NULL;
    $sSpec = '';
    $timeout = DEFAULT_TIMEOUT;
    foreach ($opt[0] as $option) switch ($option[0]) {
    case '--device':    $sDevice  = $option[1]; break;
    case '--routespec': $sSpec    = $option[1]; break;
    case '--timeout':   $timeout  = intval($option[1]); break;
    }

    if (is_null($sDevice)) {
        fwrite(STDERR, "ERR: --setroutes requires --device\n");
        return FALSE;
    }
    if (!validRouteSpec($sSpec)) {
        fwrite(STDERR, "ERR: invalid route specification\n");
        return FALSE;
    }

    $conn = connectionForDevice($sDevice);
    if (is_null($conn)) {
        fwrite(STDERR, "ERR: no NetworkManager connection bound to device $sDevice\n");
        return FALSE;
    }

    $summary = 'routes device='.$sDevice.' ['.$sSpec.']';

    return applySafely($summary, $timeout, function() use ($conn, $sSpec) {
        if (!nmcliMod($conn, array('ipv4.routes' => $sSpec))) return FALSE;
        return nmcliUp($conn);
    });
}

// Aplica un conjunto de cambios de forma atómica, con una sola confirmación si
// es bloqueante. JSON:
//   { "ifconf":[{"device","bootproto","ipaddr?","netmask?","ip6method?","ip6addr?","ip6gw?"}],
//     "genconf":{"gateway?","dns1?","dns2?","dns6?","host?"},
//     "routes":[{"device","routespec"}] }
function action_apply($opt)
{
    $sChange = NULL;
    $clientIp = NULL;
    foreach ($opt[0] as $option) switch ($option[0]) {
    case '--change':    $sChange  = $option[1]; break;
    case '--client-ip': $clientIp = $option[1]; break;
    }
    if (is_null($sChange)) {
        fwrite(STDERR, "ERR: --apply requires --change\n");
        return FALSE;
    }
    $change = json_decode($sChange, TRUE);
    if (!is_array($change)) {
        fwrite(STDERR, "ERR: invalid change set\n");
        return FALSE;
    }

    $mgmtDev  = managementDevice($clientIp);
    $mgmtConn = ($mgmtDev !== NULL) ? connectionForDevice($mgmtDev) : NULL;

    $props = array();     // conexión => propiedades (mod + up)
    $modOnly = array();   // conexión => propiedades (solo mod)
    $create = array();    // interfaces cuya conexión hay que crear
    $host = NULL;
    $blocking = FALSE;
    $summaryParts = array();

    // --- ifconf ---
    if (isset($change['ifconf']) && is_array($change['ifconf'])) {
        foreach ($change['ifconf'] as $op) {
            if (!is_array($op) || empty($op['device'])) {
                fwrite(STDERR, "ERR: ifconf requires device\n");
                return FALSE;
            }
            $dev = $op['device'];
            $conn = connectionForDevice($dev);
            if ($conn === NULL) { $conn = $dev; $create[$dev] = TRUE; }

            $p = array();
            $bootproto = isset($op['bootproto']) ? $op['bootproto'] : NULL;
            if ($bootproto === 'dhcp') {
                $p['ipv4.method'] = 'auto';
                $p['ipv4.addresses'] = '';
                $p['ipv4.gateway'] = '';
            } else if ($bootproto === 'static') {
                if (empty($op['ipaddr']) || empty($op['netmask'])) {
                    fwrite(STDERR, "ERR: static requires ipaddr and netmask\n");
                    return FALSE;
                }
                $p['ipv4.method'] = 'manual';
                $p['ipv4.addresses'] = $op['ipaddr'].'/'.netmaskToPrefix($op['netmask']);
            }
            if (!empty($op['ip6method']) || !empty($op['ip6addr']) || !empty($op['ip6gw'])) {
                $m = !empty($op['ip6method']) ? $op['ip6method'] : (empty($op['ip6addr']) ? 'auto' : 'manual');
                $p['ipv6.method'] = $m;
                if ($m === 'manual') {
                    if (empty($op['ip6addr'])) {
                        fwrite(STDERR, "ERR: IPv6 method manual requires ip6addr\n");
                        return FALSE;
                    }
                    $p['ipv6.addresses'] = $op['ip6addr'];
                } else {
                    $p['ipv6.addresses'] = '';
                    if ($m === 'disabled') $p['ipv6.gateway'] = '';
                }
                if (!empty($op['ip6gw'])) $p['ipv6.gateway'] = $op['ip6gw'];
            }
            $props[$conn] = isset($props[$conn]) ? array_merge($props[$conn], $p) : $p;
            $summaryParts[] = 'ifconf '.$dev;
            if ($bootproto !== NULL && $dev === $mgmtDev) $blocking = TRUE;
        }
    }

    // --- genconf ---
    if (isset($change['genconf']) && is_array($change['genconf'])) {
        $g = $change['genconf'];
        $primary = primaryConnection();
        if ((!empty($g['gateway']) || !empty($g['dns1']) || !empty($g['dns6'])) && $primary === NULL) {
            fwrite(STDERR, "ERR: no primary connection\n");
            return FALSE;
        }
        if (!empty($g['gateway'])) {
            $add = array('ipv4.gateway' => $g['gateway']);
            $props[$primary] = isset($props[$primary]) ? array_merge($props[$primary], $add) : $add;
            foreach (activeConnectionNames() as $c) if ($c !== $primary) $modOnly[$c] = array('ipv4.never-default' => 'yes');
            $pdev = deviceForConnection($primary);
            if ($pdev !== '' && $pdev === $mgmtDev) $blocking = TRUE;
            $summaryParts[] = 'gateway='.$g['gateway'];
        }
        if (!empty($g['dns1'])) {
            $dns = $g['dns1'].(!empty($g['dns2']) ? ' '.$g['dns2'] : '');
            $add = array('ipv4.dns' => $dns, 'ipv4.ignore-auto-dns' => 'yes');
            $props[$primary] = isset($props[$primary]) ? array_merge($props[$primary], $add) : $add;
            $summaryParts[] = 'dns='.$dns;
        }
        if (!empty($g['dns6'])) {
            $add = array('ipv6.dns' => $g['dns6'], 'ipv6.ignore-auto-dns' => 'yes');
            $props[$primary] = isset($props[$primary]) ? array_merge($props[$primary], $add) : $add;
            $summaryParts[] = 'dns6='.$g['dns6'];
        }
        if (!empty($g['host'])) { $host = $g['host']; $summaryParts[] = 'host='.$host; }
    }

    // --- routes ---
    if (isset($change['routes']) && is_array($change['routes'])) {
        foreach ($change['routes'] as $op) {
            if (!is_array($op) || empty($op['device']) || !array_key_exists('routespec', $op)) {
                fwrite(STDERR, "ERR: routes requires device and routespec\n");
                return FALSE;
            }
            $dev = $op['device'];
            $conn = connectionForDevice($dev);
            if ($conn === NULL) { $conn = $dev; $create[$dev] = TRUE; }
            if (!validRouteSpec((string)$op['routespec'])) {
                fwrite(STDERR, "ERR: invalid route specification for $dev\n");
                return FALSE;
            }
            $add = array('ipv4.routes' => $op['routespec']);
            $props[$conn] = isset($props[$conn]) ? array_merge($props[$conn], $add) : $add;
            $summaryParts[] = 'routes '.$dev;
            if ($dev === $mgmtDev) $blocking = TRUE;
        }
    }

    if (empty($props) && empty($modOnly) && is_null($host)) {
        fwrite(STDERR, "ERR: empty change set\n");
        return FALSE;
    }

    $plan = array(
        'props'   => $props,
        'modOnly' => $modOnly,
        'create'  => array_keys($create),
        'host'    => $host,
        'mgmt'    => $mgmtConn,
    );
    $summary = 'apply '.implode('; ', $summaryParts);

    if ($blocking) {
        return applySafely($summary, DEFAULT_TIMEOUT, function() use ($plan) {
            return runChangeSet($plan);
        });
    }
    // No bloqueante: se aplica sin ventana de confirmación.
    $ok = runChangeSet($plan);
    if ($ok) echo "applied\n";
    return $ok;
}

// Ejecuta un plan de change set ya validado (props por conexión + activación).
function runChangeSet($plan)
{
    foreach ($plan['create'] as $dev) {
        if (connectionForDevice($dev) === NULL) {
            if (createConnectionForDevice($dev) === NULL) return FALSE;
        }
    }
    foreach ($plan['modOnly'] as $conn => $props) {
        if (!nmcliMod($conn, $props)) return FALSE;
    }
    foreach ($plan['props'] as $conn => $props) {
        if (!nmcliMod($conn, $props)) return FALSE;
    }
    // Activa primero las que no son de gestión; la de gestión al final.
    foreach ($plan['props'] as $conn => $props) {
        if ($plan['mgmt'] !== NULL && $conn === $plan['mgmt']) continue;
        if (!nmcliUp($conn)) return FALSE;
    }
    if ($plan['mgmt'] !== NULL && isset($plan['props'][$plan['mgmt']])) {
        if (!nmcliUp($plan['mgmt'])) return FALSE;
    }
    if ($plan['host'] !== NULL) setHostname($plan['host']);
    return TRUE;
}

// Define el hostname del sistema y lo propaga a /etc/hosts y postfix.
function setHostname($sHostname)
{
    exec('/usr/bin/hostnamectl set-hostname '.escapeshellarg($sHostname));
    file_put_contents('/etc/hostname', "$sHostname\n");
    chmod('/etc/hostname', 0644);

    // En /etc/hosts, reemplaza el hostname de 127.0.0.1
    $bClavePresente = FALSE;
    $contenidoNuevo = array();
    foreach (file('/etc/hosts') as $sLinea) {
        if (preg_match('/^127\.0\.0\.1\s+/', $sLinea)) {
            $bClavePresente = TRUE;
            $contenidoNuevo[] = "127.0.0.1\tlocalhost $sHostname localhost.localdomain\n";
        } else {
            $contenidoNuevo[] = $sLinea;
        }
    }
    if ($bClavePresente) file_put_contents('/etc/hosts', $contenidoNuevo);

    // Figura un dominio para el hostname
    $partes = explode('.', $sHostname, 2);
    $sDomain = array_pop($partes);

    if (file_exists('/etc/postfix/main.cf')) {
        $bClavePresente = array('myhostname' => FALSE, 'mydomain' => FALSE);
        $contenidoNuevo = array();
        foreach (file('/etc/postfix/main.cf') as $sLinea) {
            if (preg_match('/^myhostname\s*=/', $sLinea)) {
                $bClavePresente['myhostname'] = TRUE;
                $contenidoNuevo[] = "myhostname = $sHostname\n";
            } elseif (preg_match('/^mydomain\s*=/', $sLinea)) {
                $bClavePresente['mydomain'] = TRUE;
                $contenidoNuevo[] = "mydomain = $sDomain\n";
            } else {
                $contenidoNuevo[] = $sLinea;
            }
        }
        if (!$bClavePresente['myhostname']) $contenidoNuevo[] = "myhostname = $sHostname\n";
        if (!$bClavePresente['mydomain']) $contenidoNuevo[] = "mydomain = $sDomain\n";
        file_put_contents('/etc/postfix/main.cf', $contenidoNuevo);
        exec('/usr/bin/systemctl restart postfix 2>/dev/null');
    }
}
